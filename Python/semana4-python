def ordenar_por_preco(nomes, precos, categorias):
    produtos = list(zip(precos, nomes, categorias))

    crescente = produtos.copy()
    crescente.sort()  # sort() modifica a própria lista (a cópia)

    decrescente = sorted(produtos, reverse=True)  # sorted() cria uma nova lista

    return crescente, decrescente


