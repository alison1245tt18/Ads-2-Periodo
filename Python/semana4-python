def imprimir_relatorio(nomes, precos, categorias, valor_limite,
                       filtrados, crescente, decrescente,
                       categorias_unicas, estatisticas):
    menor_preco, maior_preco, media_precos = estatisticas

    print("\n" + "=" * 50)
    print(f"{'RELATÓRIO FINAL':^50}")
    print("=" * 50)

    print("\n--- Produtos cadastrados ---")
    for nome, preco, categoria in zip(nomes, precos, categorias):
        print(f"{nome:<20} R$ {preco:>8.2f}  [{categoria}]")

    print(f"\n--- Produtos acima de R$ {valor_limite:.2f} ---")
    if filtrados:
        for nome, preco, categoria in filtrados:
            print(f"{nome:<20} R$ {preco:>8.2f}  [{categoria}]")
    else:
        print("Nenhum produto encontrado.")

    print("\n--- Preço crescente ---")
    for preco, nome, categoria in crescente:
        print(f"{nome:<20} R$ {preco:>8.2f}")

    print("\n--- Preço decrescente ---")
    for preco, nome, categoria in decrescente:
        print(f"{nome:<20} R$ {preco:>8.2f}")

    print(f"\n--- Categorias únicas ({len(categorias_unicas)}) ---")
    print(", ".join(sorted(categorias_unicas)))

    print("\n--- Estatísticas ---")
    print(f"Menor preço: R$ {menor_preco:.2f}")
    print(f"Maior preço: R$ {maior_preco:.2f}")
    print(f"Preço médio: R$ {media_precos:.2f}")
    print("=" * 50)


