def cadastrar_produtos():
    nomes = []
    precos = []
    categorias = []

    quantidade = int(input("Quantos produtos deseja cadastrar? "))
    for i in range(quantidade):
        print(f"\nProduto {i + 1}")
        nomes.append(input("Nome: ").strip())
        precos.append(float(input("Preço: ").replace(",", ".")))
        categorias.append(input("Categoria: ").strip().lower())

    return nomes, precos, categorias


