def main():
    nomes, precos, categorias = cadastrar_produtos()
    if not nomes:
        print("Nenhum produto cadastrado.")
        return

    valor_limite = float(input("\nMostrar produtos com preço acima de: ").replace(",", "."))

    filtrados = filtrar_por_preco(nomes, precos, categorias, valor_limite, acima=True)
    crescente, decrescente = ordenar_por_preco(nomes, precos, categorias)
    categorias_unicas = obter_categorias_unicas(categorias)
    estatisticas = calcular_estatisticas(precos)

    imprimir_relatorio(nomes, precos, categorias, valor_limite,
                       filtrados, crescente, decrescente,
                       categorias_unicas, estatisticas)


if __name__ == "__main__":
    main()
