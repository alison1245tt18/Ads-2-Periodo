def filtrar_por_preco(nomes, precos, categorias, valor_limite, acima=True):
    filtrados = []
    for i in range(len(nomes)):
        if (acima and precos[i] > valor_limite) or (not acima and precos[i] < valor_limite):
            filtrados.append((nomes[i], precos[i], categorias[i]))
    return filtrados


